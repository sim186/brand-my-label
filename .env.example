# PostHog (server-side events). Missing token = analytics off (error if DEBUG=1).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_DISABLED=0
DEBUG=0

# Comma-separated origins allowed to call the API (your GitHub Pages domain)
ALLOWED_ORIGINS=http://localhost:8000

MAX_LABEL_MB=10
MAX_LOGO_MB=2
RATE_LIMIT_PER_10MIN=30
